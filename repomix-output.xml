:root {
  --bg: #0b0e14;
  --bg-panel: #12161f;
  --bg-card: #171c27;
  --border: #232838;
  --text: #e6e9f0;
  --text-dim: #8b93a7;
  --accent: #5b8cff;
  --accent-2: #34d399;
  --warn: #f59e0b;
  --radius: 10px;
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
}

#are-root { min-height: 100vh; display: flex; flex-direction: column; }

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

.site-header {
  border-bottom: 1px solid var(--border);
  background: var(--bg-panel);
  padding: 14px 24px;
}
.site-header .inner {
  max-width: 960px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.brand { display: flex; align-items: center; gap: 10px; }
.brand .dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--accent-2);
  box-shadow: 0 0 8px var(--accent-2);
}
.brand h1 { font-size: 17px; margin: 0; font-weight: 600; letter-spacing: 0.2px; }

nav.site-nav { display: flex; gap: 4px; }
nav.site-nav a {
  color: var(--text-dim);
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 14px;
  transition: background 0.15s, color 0.15s;
}
nav.site-nav a:hover { background: var(--bg-card); color: var(--text); text-decoration: none; }
nav.site-nav a.active { color: var(--text); background: var(--bg-card); }

.strategy-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: var(--accent);
  background: rgba(91, 140, 255, 0.12);
  border: 1px solid rgba(91, 140, 255, 0.35);
  padding: 4px 10px;
  border-radius: 999px;
  text-transform: uppercase;
}

main.page {
  max-width: 960px;
  margin: 0 auto;
  padding: 32px 24px;
  width: 100%;
  flex: 1;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 20px;
}

.card h2 { margin-top: 0; font-size: 20px; }
.card p.lead { color: var(--text-dim); font-size: 15px; margin-bottom: 16px; }

.meta-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
.meta-list li {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 13px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color: var(--text-dim);
}

.stamp { margin-top: 18px; font-size: 12px; color: var(--text-dim); }

.table-wrap { max-height: 320px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; }
.table-wrap ul { list-style: none; margin: 0; padding: 0; }
.table-wrap li {
  padding: 8px 14px;
  font-size: 13px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color: var(--text-dim);
  border-bottom: 1px solid var(--border);
}
.table-wrap li:last-child { border-bottom: none; }

.loading-hint { color: var(--warn); font-size: 14px; }

footer.site-footer {
  border-top: 1px solid var(--border);
  padding: 18px 24px;
  text-align: center;
  color: var(--text-dim);
  font-size: 12px;
}

.live-clock { color: var(--accent-2); }
