(function () {
  var badge = document.querySelector('.strategy-badge');
  if (badge) {
    badge.style.transition = 'transform 0.2s ease';
    badge.style.transform = 'scale(1.08)';
    setTimeout(function () {
      badge.style.transform = 'scale(1)';
    }, 200);
  }

  var clockEl = document.createElement('div');
  clockEl.className = 'live-clock';
  var footer = document.querySelector('.site-footer');
  if (footer) {
    footer.appendChild(document.createElement('br'));
    footer.appendChild(clockEl);
    function tick() {
      clockEl.textContent = 'Local browser time: ' + new Date().toLocaleTimeString();
    }
    tick();
    setInterval(tick, 1000);
  }
})();
